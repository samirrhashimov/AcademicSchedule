# MongoDB bağlantısı (öz hostunda işləyən instansın URI-si)
MONGODB_URI=mongodb://user:password@host:27017/?authSource=admin

# Bu layihənin ayrıca verilənlər bazası.
# Eyni instansdakı digər layihələrdən təcrid üçün fərqli ad saxla.
MONGODB_DB_NAME=academic-schedule

# Backend portu
PORT=5000

# Frontend ünvanı (CORS üçün; vergüllə bir neçə ola bilər)
CLIENT_URL=http://localhost:5173

# JWT imza açarı (uzun, təsadüfi sətir qoy). Yaratmaq üçün:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=buraya-uzun-təsadüfi-sətir-yaz

# Şifrə bərpa e-poçtları üçün SMTP (məs: Gmail App Password və ya Resend).
# Boş olsa /forgot-password işləmir.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sen@misal.az
SMTP_PASS=buraya-app-parolu-yaz
SMTP_FROM=AcademicSchedule <sen@misal.az>

# OneSignal push (boş olsa planlayıcı işləmir, tətbiq normal açılır).
ONESIGNAL_APP_ID=bura-app-id
ONESIGNAL_API_KEY=bura-rest-api-key

# Server saat qurşağı — dərs vaxtları buna görə hesablanır.
TZ=Asia/Baku
