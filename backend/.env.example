# MongoDB bağlantısı (öz hostunda işləyən instansın URI-si)
MONGODB_URI=mongodb://user:password@host:27017/?authSource=admin

# Bu layihənin ayrıca verilənlər bazası.
# Eyni instansdakı digər layihələrdən təcrid üçün fərqli ad saxla.
MONGODB_DB_NAME=academic-schedule

# Backend portu
PORT=5000

# Frontend ünvanı (CORS üçün; vergüllə bir neçə ola bilər)
CLIENT_URL=http://localhost:5173

# JWT imza açarı (uzun, təsadüfi sətir qoy). Yaratmaq üçün:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=buraya-uzun-təsadüfi-sətir-yaz
